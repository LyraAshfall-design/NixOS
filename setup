#!/usr/bin/env bash
# Local live-ISO installer. Never run this through tee, a transcript, or bash -x.
set +x
set -Eeuo pipefail
umask 077

readonly DESKTOP_DISK=/dev/disk/by-id/nvme-SIX_X7400_SSD_STX26012100037853

usage() {
  cat <<'EOF'
Usage: ./setup [--check] <host>
       ./setup --test-disko desktop /dev/disk/by-id/<DISPOSABLE-DISK>
       ./setup --verify-disko desktop /dev/disk/by-id/<DISPOSABLE-DISK>
       ./setup --help

  desktop  nixos-desktop: reviewed SSD, GPT/ESP/Btrfs; installation ERASES it
  laptop   not implemented

Run installation as root from a NixOS live installer with an interactive terminal.
--check may run without root: evaluates the pinned configuration and inspects the
disk, but never builds/runs Disko, mounts, installs, or changes passwords. Nix may
fetch pinned sources into its store. Missing/unsafe prerequisites are failures.
Installation ERASES the selected disk after an exact typed confirmation.
No automatic reboot or automatic recovery/unmount is performed.
--test-disko ERASES only an explicitly supplied disposable disk (minimum 8 GiB),
tests the desktop filesystem layout under /mnt, and NEVER installs NixOS.
--verify-disko only inspects a completed test still mounted under /mnt.
EOF
}

die() { printf 'setup: %s\n' "$*" >&2; exit 1; }

# Add future implemented hosts here; never interpolate arbitrary user input.
select_host() {
  case "$1" in
    desktop) target=nixos-desktop ;;
    laptop|server) die "Host '$1' is not implemented in this repository." ;;
    *) die "Unknown host '$1'. Use --help for supported names." ;;
  esac
}

nix_cmd() { nix --extra-experimental-features 'nix-command flakes' "$@"; }
require_root() { (( EUID == 0 )) || die 'Installation requires root: sudo ./setup <host>'; }
require_terminal() {
  [[ -t 0 && -t 1 && -t 2 ]] || die 'Installation requires an interactive terminal, without redirection.'
}
is_uefi() { [[ -d /sys/firmware/efi ]]; }
require_uefi() { is_uefi || die 'Boot the live installer in UEFI mode.'; }
is_block_device() { [[ -b "$1" ]]; }
partition_identity_exists() { [[ -e "$1" || -L "$1" ]]; }

evaluate_plan() {
  # Include deliberately unstaged layout files without updating inputs.
  local flake_ref="path:$repo"
  # Freeze repository + locked inputs before confirmation. All later commands
  # use this store snapshot, never a working tree that can change mid-install.
  snapshot=$(nix_cmd flake archive --json --no-update-lock-file --no-write-lock-file "$flake_ref" |
    jq -er '.path | select(startswith("/nix/store/"))')
  snapshot="path:$snapshot"
  nix_cmd eval --json --no-update-lock-file "$snapshot#nixosConfigurations" \
    --apply builtins.attrNames | jq -e --arg host "$target" 'index($host) != null' >/dev/null ||
    die "Flake configuration '$target' does not exist."
  read_plan --no-update-lock-file "$snapshot#nixosConfigurations.$target.config"
}

read_plan() {
  # Nix attribute interpolation below must reach Nix verbatim, not Bash.
  # shellcheck disable=SC2016
  plan=$(nix_cmd eval --json "$@" --apply '
    c: let
      hasDisko = c ? disko && c.disko.enableConfig;
      disks = if hasDisko then builtins.attrValues c.disko.devices.disk else [];
    in {
      # Force full system evaluation, including assertions, without building it.
      systemDrv = c.system.build.toplevel.drvPath;
      diskoDrv = if hasDisko && disks != [] then c.system.build.destroyFormatMount.drvPath else null;
      platform = c.nixpkgs.hostPlatform.system;
      hostname = c.networking.hostName;
      uefi = c.boot.loader.systemd-boot.enable;
      esp = c.boot.loader.efi.efiSysMountPoint;
      mutableUser = c.users.mutableUsers && c.users.users.corey.isNormalUser;
      passwordUnmanaged = builtins.all (v: v == null) (map
        (key: c.users.users.corey.${key})
        [ "password" "hashedPassword" "hashedPasswordFile" "initialPassword" "initialHashedPassword" ]);
      swapDevices = map (s: s.device) c.swapDevices;
      inherit hasDisko;
      root = if hasDisko then c.disko.rootMountPoint else null;
      otherDevices = if hasDisko then builtins.filter (key:
        builtins.substring 0 1 key != "_" && key != "disk" && c.disko.devices.${key} != {}
      ) (builtins.attrNames c.disko.devices) else [];
      disks = map (d: {
        inherit (d) device destroy;
        contentDevice = d.content.device or null;
        type = d.content.type or null;
        partitions = map (p: {
          inherit (p) device label type;
          size = p.size;
          filesystemDevice = p.content.device or null;
          contentType = p.content.type or null;
          format = p.content.format or null;
          mountpoint = p.content.mountpoint or null;
          mountOptions = p.content.mountOptions or [];
          swap = p.content.swap or {};
          subvolumes = builtins.mapAttrs (_: s: {
            inherit (s) name mountpoint mountOptions swap;
          }) (p.content.subvolumes or {});
        }) (builtins.attrValues (d.content.partitions or {}));
      }) disks;
      filesystems = builtins.mapAttrs (_: f: { inherit (f) device fsType options; }) c.fileSystems;
    }')
}

validate_plan() {
  jq -e '.hasDisko' <<<"$plan" >/dev/null ||
    die "$target is not install-ready: no enabled Disko definition. Physical disks require a reviewed /dev/disk/by-id/... target."
  validate_desktop_plan
  [[ "$(jq -r .platform <<<"$plan")" == "$(uname -m)-linux" ]] ||
    die 'Cross-architecture installation is not supported.'
  disk=$(jq -er '.disks[0].device' <<<"$plan")
  [[ "$disk" == /dev/disk/by-id/* ]] || die 'Physical targets must use /dev/disk/by-id/... .'
  printf 'Host: %s (%s)\nFlake: %s#%s\nPlanned disk: %s\n' \
    "$friendly" "$(jq -r .hostname <<<"$plan")" "$snapshot" "$target" "$disk"
}

validate_desktop_plan() {
  # Shared Btrfs devices are intentional only with three distinct subvolume selectors.
  jq -e --arg disk "$DESKTOP_DISK" '
    .hostname == "nixos-desktop" and .root == "/mnt" and .uefi and .esp == "/boot" and
    .mutableUser and .passwordUnmanaged and .otherDevices == [] and .swapDevices == [] and
    (.disks | length) == 1 and .disks[0].destroy and .disks[0].type == "gpt" and
    .disks[0].device == $disk and .disks[0].contentDevice == $disk and
    (.disks[0].partitions | length) == 2 and
    ([.disks[0].partitions[].label] | unique | length) == 2 and
    ([.disks[0].partitions[].device] | unique | length) == 2 and
    all(.disks[0].partitions[];
      .filesystemDevice == .device and .device == ("/dev/disk/by-partlabel/" + .label) and
      (.label | test("^[A-Za-z0-9_-]+$"))) and
    (.filesystems | keys) == ["/", "/boot", "/home", "/nix"] and
    ([.disks[0].partitions[] | select(.contentType == "filesystem")] | length) == 1 and
    ([.disks[0].partitions[] | select(.contentType == "btrfs")] | length) == 1 and
    (. as $p |
      (.disks[0].partitions[] | select(.contentType == "filesystem")) as $esp |
      (.disks[0].partitions[] | select(.contentType == "btrfs")) as $b |
      $esp.size == "1G" and $esp.type == "EF00" and $esp.format == "vfat" and
      $esp.mountpoint == "/boot" and $esp.mountOptions == ["umask=0077"] and
      $p.filesystems["/boot"].device == $esp.device and
      $p.filesystems["/boot"].fsType == "vfat" and
      $p.filesystems["/boot"].options == ["umask=0077"] and
      $b.size == "100%" and $b.type == "8300" and $b.mountpoint == null and $b.swap == {} and
      ($b.subvolumes | keys) == ["@home", "@nix", "@root"] and
      all({"@root":"/", "@home":"/home", "@nix":"/nix"} | to_entries[];
        . as $s | $b.subvolumes[$s.key] as $v |
        $v.name == $s.key and $v.mountpoint == $s.value and $v.swap == {} and
        ($v.mountOptions | sort) == ["compress=zstd", "noatime"] and
        $p.filesystems[$s.value].device == $b.device and
        $p.filesystems[$s.value].fsType == "btrfs" and
        # NixOS adds this boot-order option to filesystems needed in initrd.
        ($p.filesystems[$s.value].options | map(select(. != "x-initrd.mount")) | sort) ==
          (["compress=zstd", "noatime", "subvol=" + $s.key] | sort)))
  ' <<<"$plan" >/dev/null || die 'Desktop Disko target/layout is inconsistent with the reviewed SSD, ESP and @root/@home/@nix plan.'
}

probe_disk() {
  is_block_device "$disk" || die "Target disk is missing or is not a block device: $disk"
  resolved=$(readlink -e -- "$disk")
  disk_info=$(lsblk --json --tree --bytes --paths --output PATH,KNAME,TYPE,SIZE,RO,MODEL,SERIAL,WWN,MAJ:MIN,MOUNTPOINTS -- "$resolved") || die 'Cannot inspect target disk.'
  jq -e --arg resolved "$resolved" '
    (.blockdevices | type == "array" and length == 1) and
    .blockdevices[0].path == $resolved and .blockdevices[0].type == "disk" and
    .blockdevices[0].ro == false and (.blockdevices[0].size | type == "number" and . > 0) and
    (.blockdevices[0]["maj:min"] | type == "string" and test("^[0-9]+:[0-9]+$")) and
    all(.blockdevices[] | recurse(.children[]?);
      (.path | type == "string" and startswith("/dev/")) and
      (.kname | type == "string" and length > 0) and
      (.mountpoints | type == "array") and
      (.children == null or (.children | type == "array")))' <<<"$disk_info" >/dev/null ||
    die 'Target is not one writable whole disk.'
  if [[ "$target" == nixos-desktop ]]; then
    [[ "$disk" == "$DESKTOP_DISK" && "$resolved" == /dev/nvme0n1 ]] || die 'Unexpected desktop stable disk or resolved device.'
    jq -e '.blockdevices[0] |
      .model == "SIX X7400 SSD" and .serial == "STX26012100037853" and
      (.size >= (1024209543168 - 1073741824) and .size <= (1024209543168 + 1073741824))' \
      <<<"$disk_info" >/dev/null || die 'Desktop model, serial or capacity differs from the reviewed SSD (953.9 GiB, tolerance 1 GiB).'
    local inventory
    inventory=$(lsblk --json --nodeps --bytes --paths --output PATH,TYPE,MODEL,SERIAL,SIZE) || die 'Cannot inspect physical disk identities.'
    jq -e --arg resolved "$resolved" '
      [.blockdevices[] | select(.serial == "STX26012100037853")] |
      length == 1 and .[0].path == $resolved and .[0].type == "disk"' \
      <<<"$inventory" >/dev/null || die 'Desktop SSD identity is ambiguous.'
  fi
  fingerprint=$(jq -c '.blockdevices[0] | {path,"maj:min",size,model,serial,wwn}' <<<"$disk_info")
}

check_mount_directory() {
  local root=${1:-/mnt} mounts first_entry
  [[ ! -L "$root" && ! -L "$root/boot" ]] || die 'Install mount paths must not be symlinks.'
  mounts=$(findmnt --json --output TARGET) || die 'Cannot inspect mounted filesystems.'
  jq -e --arg root "$root" '(.filesystems | type == "array" and length > 0) and
    all(.filesystems[] | recurse(.children[]?);
    (.target | type == "string" and startswith("/")) and
    .target != $root and (.target | startswith($root + "/") | not))' <<<"$mounts" >/dev/null ||
    die '/mnt is already in use. Inspect/unmount it manually; setup never cleans an old installation automatically.'
  if [[ -e "$root" ]]; then
    [[ -d "$root" ]] || die '/mnt must be a directory.'
    # Inspect separately: a failed command must never look like empty output.
    first_entry=$(find "$root" -mindepth 1 -maxdepth 1 -printf 'occupied' -quit) ||
      die 'Cannot inspect install mount directory.'
    [[ -z "$first_entry" ]] || die '/mnt must be an empty directory.'
  fi
}

# Recognize only the official ISO's tmpfs/iso9660/squashfs/overlay topology.
# copytoram, network boot and loop-backed ISO images are deliberately unsupported.
live_iso_source() {
  local mounts='[]' mp info media loop_device loop_info media_id
  command -v losetup >/dev/null || die 'Missing losetup for live-ISO inspection.'
  for mp in / /iso /nix/.ro-store /nix/.rw-store /nix/store; do
    info=$(findmnt --json --nofsroot --mountpoint "$mp" --output TARGET,SOURCE,FSTYPE,FSROOT,OPTIONS,MAJ:MIN) || die "Cannot inspect live-ISO mount: $mp"
    jq -e --arg mp "$mp" '
      (.filesystems | type == "array") and
      all(.filesystems[]; .target == $mp and .fsroot == "/" and
        (.source | type == "string") and (.options | type == "string")) and
      ((.filesystems | length == 1) or
        ($mp == "/nix/store" and (.filesystems | length == 2) and
          all(.filesystems[]; .fstype == "overlay" and .source == "overlay" and
            (.["maj:min"] | test("^[0-9]+:[0-9]+$"))) and
          ([.filesystems[] | .["maj:min"]] | unique | length == 1) and
          ([.filesystems[] | .options | split(",") |
            map(select(. == "rw" or . == "ro"))] | sort == [["ro"], ["rw"]]) and
          ([.filesystems[] | .options | split(",") |
            if index("ro") != null then
              # Only the ro view may add the observed nosuid,nodev pair.
              if (map(select(. == "nosuid" or . == "nodev")) | sort) == ["nodev", "nosuid"]
              then map(select(. != "nosuid" and . != "nodev"))
              else . end
            else . end |
            map(select(. != "rw" and . != "ro")) | sort] | unique | length == 1)))
    ' <<<"$info" >/dev/null || die "Ambiguous live-ISO mount: $mp"
    # The official graphical ISO may expose the same store overlay twice,
    # once rw and once ro. Collapse only the validated pair for topology checks.
    mounts=$(jq --argjson info "$info" '. + [$info.filesystems[0]]' <<<"$mounts") || die 'Cannot collect live-ISO mounts.'
  done
  jq -e '
    .[0].fstype == "tmpfs" and
    .[1].fstype == "iso9660" and (.[1].source | startswith("/dev/")) and
    (.[1]["maj:min"] | test("^[0-9]+:[0-9]+$")) and
    .[2].fstype == "squashfs" and (.[2].options | split(",") | index("ro") != null) and
    .[3].fstype == "tmpfs" and .[4].fstype == "overlay" and
    (.[4].options | split(",") | . as $opts |
      any(["", "/sysroot", "/mnt-root"][]; . as $prefix |
        ($opts | index("lowerdir=" + $prefix + "/nix/.ro-store")) != null and
        ($opts | index("upperdir=" + $prefix + "/nix/.rw-store/store")) != null and
        ($opts | index("workdir=" + $prefix + "/nix/.rw-store/work")) != null))
  ' <<<"$mounts" >/dev/null || die 'Unsupported live-ISO topology (copytoram/custom layouts refused).'
  media=$(jq -er '.[1].source' <<<"$mounts") || die 'Missing ISO media source.'
  media_id=$(jq -er '.[1]["maj:min"]' <<<"$mounts") || die 'Missing ISO media identity.'
  loop_device=$(readlink -e -- "$(jq -er '.[2].source' <<<"$mounts")") || die 'Cannot resolve live squashfs loop.'
  [[ "$loop_device" =~ ^/dev/loop[0-9]+$ ]] || die 'Unsupported live squashfs device.'
  # Read-only loop metadata proves squashfs is backed by this mounted ISO,
  # rather than an unrelated disk hidden behind the RAM-backed root.
  loop_info=$(losetup --list --json --output NAME,BACK-MAJ:MIN -- "$loop_device") || die 'Cannot inspect live squashfs backing device.'
  jq -e --arg loop "$loop_device" --arg id "$media_id" '
    (.loopdevices | type == "array" and length == 1) and
    .loopdevices[0].name == $loop and .loopdevices[0]["back-maj:min"] == $id
  ' <<<"$loop_info" >/dev/null || die 'Live squashfs backing device does not match ISO media.'
  printf '%s\n' "$media"
}

check_live_root_separation() {
  local root_source root_resolved ancestors live_disk live_tree iso=false
  # Protect either a partition-backed root or the explicitly verified ISO media.
  # findmnt reports the actual partition source; /dev/block/<major>:<minor>
  # is not a portable pathname and was the cause of the previous false refusal.
  root_source=$(findmnt --noheadings --raw --nofsroot --mountpoint / --output SOURCE) || die 'Cannot identify live root.'
  if [[ "$root_source" != /dev/* ]]; then
    root_source=$(live_iso_source) || die 'Cannot safely identify live installation media.'
    iso=true
  fi
  root_resolved=$(readlink -e -- "$root_source") || die 'Cannot resolve live root source.'
  is_block_device "$root_resolved" || die 'Live root source is not an identifiable block device; disposable test refused.'
  ancestors=$(lsblk --json --inverse --paths --output PATH,TYPE -- "$root_resolved") || die 'Cannot inspect live-root ancestry.'
  jq -e --arg root "$root_resolved" --argjson iso "$iso" '
    (.blockdevices | type == "array" and length == 1) and
    .blockdevices[0].path == $root and
    (.blockdevices[0].type == "part" or ($iso and (.blockdevices[0].type == "disk" or .blockdevices[0].type == "rom")))
  ' <<<"$ancestors" >/dev/null || die 'Invalid live-root ancestry inventory.'
  live_disk=$(jq -er '[.blockdevices[] | recurse(.children[]?) | select(.type == "disk" or .type == "rom") | .path] |
    unique | if length == 1 then .[0] else error("ambiguous live-root disk") end' <<<"$ancestors") ||
    die 'Live-root disk ancestry is missing or ambiguous.'
  live_tree=$(lsblk --json --tree --paths --output PATH,TYPE -- "$live_disk") || die 'Cannot inspect live-root disk tree.'
  jq -e --arg disk "$live_disk" --arg root "$root_resolved" '
    (.blockdevices | type == "array" and length == 1) and
    .blockdevices[0].path == $disk and (.blockdevices[0].type == "disk" or .blockdevices[0].type == "rom") and
    all(.blockdevices[] | recurse(.children[]?);
      (.path | type == "string" and startswith("/dev/")) and
      (.type == "disk" or .type == "part" or .type == "rom") and
      (.children == null or (.children | type == "array"))) and
    ($root == $disk or any(.blockdevices[0].children[]?; .path == $root and .type == "part"))
  ' <<<"$live_tree" >/dev/null || die 'Invalid or incomplete live-root disk tree.'
  jq -e --arg dev "$resolved" 'any(.blockdevices[] | recurse(.children[]?); .path == $dev) | not' <<<"$live_tree" >/dev/null ||
    die 'Selected target is the live-root disk or one of its partitions.'
}

check_holders() {
  local directory=$1 entries
  [[ -d "$directory" && -r "$directory" && -x "$directory" ]] || die "Cannot inspect holder directory: $directory"
  entries=$(find "$directory" -mindepth 1 -maxdepth 1 -printf occupied -quit) || die "Cannot inspect holders: $directory"
  [[ -z "$entries" ]] || die "Active block-device holder: $directory"
}

check_unused() {
  local swaps node all_disks nodes device canonical label candidates candidate chosen
  local -a identities=()
  check_live_root_separation
  jq -e 'all(.blockdevices[] | recurse(.children[]?);
    (.type == "disk" or .type == "part") and
    all(.mountpoints[]?; . == null or . == ""))' <<<"$disk_info" >/dev/null ||
    die 'Target or a child is mounted, swap, or a mapped/RAID device. Nothing will be automatically deactivated.'
  # Reject holders even if lsblk did not report a mounted descendant.
  nodes=$(jq -er '.blockdevices[] | recurse(.children[]?) | .kname' <<<"$disk_info") || die 'Cannot enumerate disk children.'
  while IFS= read -r node; do
    check_holders "/sys/class/block/${node##*/}/holders"
  done <<<"$nodes"
  swaps=$(swapon --show --noheadings --raw --output NAME) || die 'Cannot inspect active swap.'
  while IFS= read -r node; do
    [[ -n "$node" ]] || continue
    node=$(readlink -e -- "$node") || die 'Cannot resolve active swap.'
    jq -e --arg node "$node" 'all(.blockdevices[] | recurse(.children[]?); .path != $node)' \
      <<<"$disk_info" >/dev/null || die 'Target contains active swap.'
  done <<<"$swaps"
  check_mount_directory
  # Disko formats by partition label. A matching label on ANOTHER disk could
  # otherwise redirect formatting away from the disk named in the confirmation.
  all_disks=$(lsblk --json --tree --paths --output PATH,PARTLABEL) || die 'Cannot inspect partition labels.'
  jq -e --argjson plan "$plan" --argjson target_disk "$disk_info" '
    (.blockdevices | type == "array" and length > 0) and (
    [$target_disk.blockdevices[] | recurse(.children[]?) | .path] as $paths |
    [$plan.disks[0].partitions[].label] as $labels |
    all(.blockdevices[] | recurse(.children[]?);
      . as $node | ($labels | index($node.partlabel)) == null or
      ($paths | index($node.path)) != null))' <<<"$all_disks" >/dev/null ||
    die 'A target partition label also exists on another disk; resolve the collision first.'
  # A label must not identify two distinct partitions even on this same disk.
  nodes=$(jq -er '.disks[0].partitions[].label' <<<"$plan") || die 'Cannot enumerate planned labels.'
  while IFS= read -r label; do
    candidates=$(jq -r --arg label "$label" '
      .blockdevices[] | recurse(.children[]?) | select(.partlabel == $label) | .path
    ' <<<"$all_disks") || die 'Cannot inspect planned label identities.'
    chosen=''
    while IFS= read -r candidate; do
      [[ -n "$candidate" ]] || continue
      canonical=$(readlink -e -- "$candidate") || die 'Cannot resolve planned label identity.'
      is_block_device "$canonical" || die 'Planned label is not a block device.'
      [[ -z "$chosen" || "$chosen" == "$canonical" ]] || die 'Ambiguous planned partition label.'
      chosen=$canonical
    done <<<"$candidates"
  done <<<"$nodes"
  # Inspect each planned partition once, not each Btrfs subvolume mount.
  # Distinct planned partitions must not resolve to the same block device, or to a
  # device outside the confirmed disk. Missing labels are normal before GPT creation.
  nodes=$(jq -er '.disks[0].partitions[].device' <<<"$plan") || die 'Cannot enumerate filesystem targets.'
  while IFS= read -r device; do
    if partition_identity_exists "$device"; then
      canonical=$(readlink -e -- "$device") || die "Cannot resolve filesystem target: $device"
      is_block_device "$canonical" || die "Not a block device: $device"
      jq -e --arg dev "$canonical" 'any(.blockdevices[] | recurse(.children[]?); .path == $dev)' \
        <<<"$disk_info" >/dev/null || die "Filesystem target is outside the confirmed disk: $device"
      for node in "${identities[@]}"; do
        [[ "$node" != "$canonical" ]] || die 'Filesystem targets resolve to the same device.'
      done
      identities+=("$canonical")
    fi
  done <<<"$nodes"
}

show_disk() {
  if [[ "$target" == nixos-desktop ]]; then
    printf '\nDESKTOP SSD: verify the identity and backups before erasure.\n'
  fi
  printf '\n========== DESTRUCTIVE INSTALLATION PLAN ==========\n'
  printf 'Host: %s\nFlake configuration: %s\nDISK TO ERASE: %s -> %s\n' "$friendly" "$target" "$disk" "$resolved"
  jq -r '.blockdevices[0] | "Model: \(.model // "unavailable")\nSerial: \(.serial // "unavailable")\nWWN: \(.wwn // "unavailable")\nSize: \(.size) bytes"' <<<"$disk_info"
  lsblk --paths --output NAME,TYPE,SIZE,FSTYPE,PARTLABEL,MOUNTPOINTS -- "$resolved"
  printf 'ALL DATA on this disk will be lost during installation.\n===================================================\n'
}

confirm_erase() {
  local confirmation
  # main has required terminal stdin/stdout/stderr before reaching this point.
  printf '\nType exactly ERASE %s to continue: ' "$disk"
  IFS= read -r confirmation || die 'No confirmation received.'
  [[ "$confirmation" == "ERASE $disk" ]] || die 'Confirmation did not match; nothing erased.'
}

verified_partition() {
  local label=$1 node=$2 inventory=$3 candidates candidate canonical parent metadata identity chosen='' chosen_id=''
  candidates=$(jq -er --arg label "$label" '
    [.blockdevices[] | recurse(.children[]?) | select(.partlabel == $label) | .path] |
    if length > 0 and all(.[]; type == "string" and startswith("/dev/"))
    then .[] else error("missing partition identity") end' <<<"$inventory") || die "Missing partition identity: $label"
  # Include the expected label alias and GPT node; all identities must agree.
  candidates+=$'\n'"/dev/disk/by-partlabel/$label"$'\n'"$node"
  while IFS= read -r candidate; do
    canonical=$(readlink -e -- "$candidate") || die "Cannot resolve partition identity: $candidate"
    is_block_device "$canonical" || die "Partition identity is not a block device: $candidate"
    metadata=$(lsblk --json --nodeps --paths --output PATH,TYPE,PKNAME,PARTLABEL,MAJ:MIN -- "$canonical") || die 'Cannot inspect partition identity.'
    jq -e --arg dev "$canonical" --arg label "$label" '
      (.blockdevices | length) == 1 and (.blockdevices[0] |
      .path == $dev and .type == "part" and .partlabel == $label and
      (.pkname | type == "string" and startswith("/dev/")) and
      (.["maj:min"] | type == "string" and test("^[0-9]+:[0-9]+$")))' <<<"$metadata" >/dev/null || die 'Invalid partition identity metadata.'
    parent=$(readlink -e -- "$(jq -er '.blockdevices[0].pkname' <<<"$metadata")") || die 'Cannot resolve partition parent.'
    [[ "$parent" == "$resolved" ]] || die 'Partition belongs to another disk.'
    identity=$(jq -er '.blockdevices[0]["maj:min"]' <<<"$metadata") || die 'Missing partition device number.'
    if [[ -n "$chosen" ]]; then
      [[ "$canonical" == "$chosen" && "$identity" == "$chosen_id" ]] || die 'Ambiguous partition identities.'
    else
      chosen=$canonical chosen_id=$identity
    fi
  done <<<"$candidates"
  printf '%s %s\n' "$chosen" "$chosen_id"
}

verify_mount_mapping() {
  local esp_id=$1 root=$2 mp info expected source source_device
  for mp in / /home /nix /boot; do
    info=$(findmnt --json --nofsroot --mountpoint "/mnt${mp%/}" --output SOURCE,MAJ:MIN,FSTYPE,FSROOT,OPTIONS) || die "Missing target mount: $mp"
    if [[ "$mp" == /boot ]]; then
      jq -e --arg id "$esp_id" '(.filesystems | length) == 1 and (.filesystems[0] |
        .["maj:min"] == $id and .fstype == "vfat" and .fsroot == "/" and
        (.options | split(",") | (index("umask=0077") != null or
          (index("fmask=0077") != null and index("dmask=0077") != null))))' <<<"$info" >/dev/null || die 'Incorrect target ESP mount/permissions.'
    else
      case "$mp" in /) expected=/@root ;; /home) expected=/@home ;; /nix) expected=/@nix ;; esac
      # Btrfs mount MAJ:MIN is an anonymous filesystem device (e.g. 0:97),
      # not the backing partition's device number. --nofsroot exposes only
      # the source device; FSROOT independently verifies the subvolume below.
      source=$(jq -er 'if (.filesystems | length) == 1 then
        .filesystems[0].source | select(type == "string" and startswith("/dev/"))
        else error("ambiguous mount source") end' <<<"$info") || die "Missing Btrfs backing device: $mp"
      source_device=$(readlink -e -- "$source") || die "Cannot resolve Btrfs backing device: $mp"
      is_block_device "$source_device" && [[ "$source_device" == "$root" ]] || die "Incorrect Btrfs backing device: $mp"
      jq -e --arg subvol "$expected" '(.filesystems | length) == 1 and (.filesystems[0] |
        .fstype == "btrfs" and .fsroot == $subvol and
        (.options | split(",") | index("noatime") != null and any(.[]; test("^compress=zstd(:[0-9]+)?$"))))' \
        <<<"$info" >/dev/null || die "Incorrect target Btrfs mount: $mp"
    fi
  done
}

verify_mounts() {
  local inventory esp root esp_id root_id verified node
  inventory=$(lsblk --json --list --paths --output PATH,PARTLABEL) || die 'Cannot enumerate partition identities.'
  node=$(jq -er '.filesystems["/boot"].device' <<<"$plan") || die 'Missing planned ESP.'
  verified=$(verified_partition disk-main-ESP "$node" "$inventory") || die 'ESP identity verification failed.'
  read -r esp esp_id <<<"$verified"
  node=$(jq -er '.filesystems["/"].device' <<<"$plan") || die 'Missing planned root.'
  verified=$(verified_partition disk-main-root "$node" "$inventory") || die 'Root identity verification failed.'
  read -r root root_id <<<"$verified"
  [[ "$esp" != "$root" && "$esp_id" != "$root_id" ]] || die 'Ambiguous partition identities.'
  verify_mount_mapping "$esp_id" "$root"
}

lock_installation() {
  exec 9>/run/nixos-repo-setup.lock
  flock -n 9 || die 'Another setup installation is running.'
}

build_disko() {
  script_output=$(nix_cmd build --no-link --print-out-paths --no-update-lock-file \
    "$snapshot#nixosConfigurations.$target.config.system.build.destroyFormatMount" 9>&-)
  [[ "$script_output" == /nix/store/* && "$script_output" != *$'\n'* &&
    -x "$script_output/bin/disko-destroy-format-mount" ]] || die 'Unexpected Disko script output.'
}

run_disko() {
  "$script_output/bin/disko-destroy-format-mount" --yes-wipe-all-disks 9>&-
}

set_password() {
  # Direct terminal I/O to the INSTALLED passwd; no shell variable, pipe, log,
  # password argument, Nix expression, or temporary password file is involved.
  nixos-enter --root /mnt -c '/nix/var/nix/profiles/system/sw/bin/passwd corey' \
    9>&- </dev/tty >/dev/tty 2>/dev/tty
}

verify_installation() {
  verify_mounts
  [[ -e /mnt/boot/EFI/systemd/systemd-bootx64.efi || -e /mnt/boot/EFI/systemd/systemd-bootaa64.efi ]] ||
    die 'Installed systemd-boot EFI executable is missing.'
  compgen -G '/mnt/boot/loader/entries/nixos*.conf' >/dev/null || die 'No NixOS systemd-boot entry was installed.'
  nixos-enter --root /mnt -c '/nix/var/nix/profiles/system/sw/bin/id corey' 9>&-
}

# Shared installation sequence; main enforces host selection and privilege checks.
install_target() {
  check_unused
  if "$check"; then
    printf '\nCHECK PASSED. Nothing was erased, mounted, installed, or password-modified.\n'
    return
  fi

  # Lock only installation, not --check. Close FD 9 in long-lived child commands.
  lock_installation
  phase='building the pinned Disko helper (not executing it)'
  build_disko
  expected=$fingerprint
  probe_disk
  [[ "$fingerprint" == "$expected" ]] || die 'Disk identity changed during preflight.'
  check_unused
  show_disk
  confirm_erase
  probe_disk
  [[ "$fingerprint" == "$expected" ]] || die 'Disk identity changed after confirmation.'
  check_unused

  phase='partitioning/formatting/mounting'
  # Pinned Disko module output; flag confirmed in its lib/default.nix. The exact
  # disk confirmation above replaces Disko's weaker yes/no prompt.
  run_disko
  verify_mounts
  phase='NixOS installation'
  nixos-install --root /mnt --flake "$snapshot#$target" --no-root-password \
    --no-channel-copy --no-update-lock-file --no-write-lock-file \
    --option extra-experimental-features 'nix-command flakes' 9>&-
  phase='verification before setting password'
  verify_installation
  phase='setting Corey password'
  printf '\nSet Corey\047s local password now. setup never reads or stores it.\n'
  set_password
  phase='post-install verification'
  verify_installation
  printf '\nInstallation complete. Filesystems remain mounted under /mnt.\nReboot manually when ready; setup will not reboot.\n'
}

main() {
  local check=false repo snapshot plan disk resolved disk_info fingerprint friendly target
  local phase=preflight command expected script_output
  trap 'printf "setup: failed during %s (line %s). No automatic rollback/unmount; inspect before retrying.\n" "$phase" "$LINENO" >&2' ERR
  trap 'printf "setup: interrupted; no automatic rollback/unmount.\n" >&2; exit 130' INT
  trap 'printf "setup: terminated; no automatic rollback/unmount.\n" >&2; exit 143' TERM
  if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then usage; return; fi
  if [[ "${1:-}" == --test-disko || "${1:-}" == --verify-disko ]]; then
    (( $# == 3 )) && [[ "$2" == desktop ]] || die 'Use --test-disko or --verify-disko desktop /dev/disk/by-id/<DISPOSABLE-DISK>.'
    repo=$(readlink -e -- "${BASH_SOURCE[0]}")
    repo=${repo%/*}
    # Only this explicit entry point loads the disposable-device override.
    # Lint this helper separately (or with shellcheck -x); normal shellcheck does
    # not follow external files without an explicit command-line option.
    # shellcheck source=tests/disposable-disko.sh disable=SC1091
    source "$repo/tests/disposable-disko.sh"
    disposable_main "$1" "$3" "$repo"
    return
  fi
  if [[ "${1:-}" == --check ]]; then check=true; shift; fi
  (( $# == 1 )) || { usage >&2; die 'Provide exactly one host.'; }
  friendly=$1
  select_host "$friendly"
  if ! "$check"; then require_root; require_terminal; fi
  for command in nix jq git lsblk findmnt swapon readlink uname find flock nixos-install nixos-enter; do
    command -v "$command" >/dev/null || die "Missing required tool: $command (use a NixOS live installer)."
  done
  repo=$(readlink -e -- "${BASH_SOURCE[0]}")
  repo=${repo%/*}
  [[ -f "$repo/flake.nix" && -f "$repo/flake.lock" ]] || die 'Run the setup script from its repository checkout.'
  evaluate_plan
  validate_plan
  require_uefi
  probe_disk
  show_disk
  if [[ "$target" == nixos-desktop ]] && "$check"; then
    # Mounted production storage is allowed ONLY in this review-only branch.
    # Return before unused-disk checks, locking, builds, confirmations or operations.
    printf '\nCurrent mounts (read-only inspection):\n'
    findmnt --real --output SOURCE,TARGET,FSTYPE,OPTIONS
    printf '\nUEFI: yes; Disko evaluates: yes. Planned fresh-install mounts:\n'
    jq '.filesystems' <<<"$plan"
    printf '\nDESKTOP REVIEW CHECK PASSED. Production disk may be mounted. This is an identity/layout review, not installation readiness or erase authorization.\n'
    return
  fi
  install_target
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
